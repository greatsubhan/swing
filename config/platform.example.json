{
  "oanda_environment": "practice",
  "oanda_price": "M",
  "routes": [
    {
      "strategy_id": "little_rzy",
      "enabled": true,
      "watchlist": "primary-4h",
      "granularity": "H4",
      "higher_timeframe": "1d",
      "interval_minutes": 240,
      "dispatch": "discord",
      "discord_webhook_url": "${DISCORD_WEBHOOK_URL_LITTLE_RZY}",
      "output_dir": "platform_output/little_rzy",
      "state_file": "platform_output/little_rzy/sent_state.json",
      "use_market_profile": true
    },
    {
      "strategy_id": "strategy_two",
      "enabled": true,
      "watchlist": "core-4h",
      "granularity": "H4",
      "higher_timeframe": "1d",
      "interval_minutes": 240,
      "dispatch": "discord",
      "discord_webhook_url": "${DISCORD_WEBHOOK_URL_STRATEGY_TWO}",
      "output_dir": "platform_output/strategy_two",
      "state_file": "platform_output/strategy_two/sent_state.json",
      "journal_file": "platform_output/strategy_two/signal_journal.json",
      "report_state_file": "platform_output/strategy_two/report_state.json",
      "use_market_profile": false
    }
  ]
}
